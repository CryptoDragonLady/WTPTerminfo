# wt-advanced: Comprehensive profile for Windows Terminal Preview 1.26+
wt-advanced|Windows Terminal Preview 1.26 (256-color with advanced extensions),
    am, bce, hs, mir, msgr, npc, xenl,
    colors#256, pairs#32767, cols#80, lines#24,
    bel=^G, clear=\E[H\E[2J, cr=^M, cub1=^H, cud1=^J, cuf1=\E[C,
    cuu1=\E[A, cup=\E[%i%p1%d;%p2%dH, home=\E[H, ind=^J,
    bold=\E[1m, rev=\E[7m, sgr0=\E[m,
    smso=\E[7m, rmso=\E[27m,
    smul=\E[4m, rmul=\E[24m,
    ritm=\E[23m, sitm=\E[3m,
    rmam=\E[?7l, smam=\E[?7h,
    civis=\E[?25l, cnorm=\E[?25h,
    op=\E[39;49m,
    setaf=\E[%?%p1%{8}%<%t3%p1%d%e%p1%{16}%<%t9%p1%{8}%-%d%e38;5;%p1%d%;m,
    setab=\E[%?%p1%{8}%<%t4%p1%d%e%p1%{16}%<%t10%p1%{8}%-%d%e48;5;%p1%d%;m,
    smkx=\E[?1h\E=, rmkx=\E[?1l\E>,
    khome=\E[1~, kend=\E[4~, kich1=\E[2~, kdch1=\E[3~,
    kcub1=\EOD, kcuf1=\EOC, kcuu1=\EOA, kcud1=\EOB,
    kpp=\E[5~, knp=\E[6~, kf1=\EOP, kf2=\EOQ, kf3=\EOR, kf4=\EOS,
    kf5=\E[15~, kf6=\E[17~, kf7=\E[18~, kf8=\E[19~, kf9=\E[20~,
    kf10=\E[21~, kf11=\E[23~, kf12=\E[24~,
