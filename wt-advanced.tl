    Sync=\E[?2026%?%p1%{1}%=%th%el%;,
    Smulx=\E]8;;%p1%s\E\\,
    Rmulx=\E]8;;\E\\,
    Smol=\E[53m, Rmol=\E[55m,
    Smul2=\E[4:2m, Smulc=\E[4:3m, Smuld=\E[4:4m, Smule=\E[4:5m,
    Smkb=\E[?2048h, Rmkb=\E[?2048l,
